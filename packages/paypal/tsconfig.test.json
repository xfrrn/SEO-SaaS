{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": ".",
    "outDir": "${configDir}/node_modules/.cache/ts/test-out",
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/ts/test-tsbuildinfo"
  },
  "include": ["./src", "./test"]
}
