{
  "name": "@app/paypal",
  "version": "0.1.0",
  "private": true,
  "description": "Server-only PayPal Orders client",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --build tsconfig.json && tsc --project tsconfig.test.json --noEmit",
    "lint:package": "publint run --strict --pack false"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest",
    "@app/business": "workspace:*"
  },
  "peerDependencies": {
    "@app/business": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@app/business": {
      "optional": true
    }
  },
  "dependencies": {
    "@better-auth/core": "workspace:^"
  }
}
