# 基础认证：复制为 .env，所有变量仅供服务端使用。
# 使用密码管理器生成至少 32 字符的随机密钥；不要提交真实密钥。
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 例如 postgresql://用户名:密码@localhost:5432/数据库名
DATABASE_URL=

# 可选支付：安装 Stripe 并复制 billing/ 后才需要填写。
# 在 Stripe Dashboard 的测试环境取得 secret key 和 recurring price ID。
STRIPE_SECRET_KEY=
# 本地使用 Stripe CLI listen 输出的 whsec_...；线上使用 webhook endpoint 的 signing secret。
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# 可选 PayPal 一次性付款：复制 paypal/ 内容后填写，密钥仅供服务端使用。
# 在 PayPal Developer Dashboard 创建 REST 应用；sandbox 与 live 的凭据不能混用。
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 对应当前应用的 /api/paypal/webhook endpoint 的 webhook ID（不是 client ID）。
PAYPAL_WEBHOOK_ID=
