{
  "name": "@app/auth-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Application SDK for Better Auth authentication and optional payments",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --build tsconfig.json && tsc --project tsconfig.test.json --noEmit",
    "lint:package": "publint run --strict --pack false"
  },
  "exports": {
    "./credits": {
      "dev-source": "./src/credits.ts",
      "types": "./dist/credits.d.mts",
      "default": "./dist/credits.mjs"
    },
    "./credits/client": {
      "dev-source": "./src/credits/client.ts",
      "types": "./dist/credits/client.d.mts",
      "default": "./dist/credits/client.mjs"
    },
    "./subscription": {
      "dev-source": "./src/subscription.ts",
      "types": "./dist/subscription.d.mts",
      "default": "./dist/subscription.mjs"
    },
    "./subscription/client": {
      "dev-source": "./src/subscription/client.ts",
      "types": "./dist/subscription/client.d.mts",
      "default": "./dist/subscription/client.mjs"
    },
    "./server": {
      "dev-source": "./src/server.ts",
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./react": {
      "dev-source": "./src/react.ts",
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./next-js": {
      "dev-source": "./src/next-js.ts",
      "types": "./dist/next-js.d.mts",
      "default": "./dist/next-js.mjs"
    },
    "./plugins": {
      "dev-source": "./src/plugins.ts",
      "types": "./dist/plugins.d.mts",
      "default": "./dist/plugins.mjs"
    },
    "./client/plugins": {
      "dev-source": "./src/client/plugins.ts",
      "types": "./dist/client/plugins.d.mts",
      "default": "./dist/client/plugins.mjs"
    },
    "./paypal": {
      "dev-source": "./src/paypal.ts",
      "types": "./dist/paypal.d.mts",
      "default": "./dist/paypal.mjs"
    },
    "./stripe": {
      "dev-source": "./src/stripe.ts",
      "types": "./dist/stripe.d.mts",
      "default": "./dist/stripe.mjs"
    },
    "./stripe/client": {
      "dev-source": "./src/stripe/client.ts",
      "types": "./dist/stripe/client.d.mts",
      "default": "./dist/stripe/client.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "credits": [
        "./dist/credits.d.mts"
      ],
      "credits/client": [
        "./dist/credits/client.d.mts"
      ],
      "subscription": [
        "./dist/subscription.d.mts"
      ],
      "subscription/client": [
        "./dist/subscription/client.d.mts"
      ],
      "server": [
        "./dist/server.d.mts"
      ],
      "react": [
        "./dist/react.d.mts"
      ],
      "next-js": [
        "./dist/next-js.d.mts"
      ],
      "plugins": [
        "./dist/plugins.d.mts"
      ],
      "client/plugins": [
        "./dist/client/plugins.d.mts"
      ],
      "paypal": [
        "./dist/paypal.d.mts"
      ],
      "stripe": [
        "./dist/stripe.d.mts"
      ],
      "stripe/client": [
        "./dist/stripe/client.d.mts"
      ]
    }
  },
  "dependencies": {
    "@app/credits": "workspace:^",
    "@app/paypal": "workspace:^",
    "@app/subscription": "workspace:^"
  },
  "devDependencies": {
    "@better-auth/core": "workspace:*",
    "@better-auth/stripe": "workspace:*",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "better-auth": "workspace:*",
    "next": "^16.3.4",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "stripe": "^22.0.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  },
  "peerDependencies": {
    "better-auth": "workspace:^",
    "@better-auth/stripe": "workspace:^",
    "next": "^14 || ^15 || ^16",
    "react": "^18 || ^19",
    "stripe": "^18 || ^19 || ^20 || ^21 || ^22"
  },
  "peerDependenciesMeta": {
    "@better-auth/stripe": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  }
}
