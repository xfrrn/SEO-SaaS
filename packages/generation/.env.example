# 由宿主加载，SDK 不自动读取此文件。不要使用 NEXT_PUBLIC_ 前缀。
GENERATION_OPENAI_API_KEY=
GENERATION_OPENAI_IMAGE_MODEL=
GENERATION_GOOGLE_API_KEY=
GENERATION_GOOGLE_IMAGE_MODEL=
GENERATION_GOOGLE_VIDEO_MODEL=
GENERATION_FAL_API_KEY=
GENERATION_KIE_API_KEY=
GENERATION_KIE_BASE_URL=https://api.kie.ai/api/v1/
# 必须由宿主选取实际结果 CDN 域名并解析为 downloadHosts，不允许通配所有域名。
GENERATION_KIE_DOWNLOAD_HOSTS=
# 在宿主将这些值转换为 generation({ limits: ... }) 参数。
GENERATION_OPERATION_TIMEOUT_MS=120000
GENERATION_LEASE_MS=180000
GENERATION_POLL_INTERVAL_MS=10000
GENERATION_TASK_TIMEOUT_MS=86400000
