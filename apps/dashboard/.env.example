# Copy this file to .env.local. Never commit .env.local.
BETTER_AUTH_URL=http://127.0.0.1:3001
# Generate a unique random secret with at least 32 characters. Empty is invalid.
BETTER_AUTH_SECRET=

# Choose ONE database. SQLite is local development only, never production.
DATABASE_URL=
DASHBOARD_SQLITE_PATH=.data/dashboard.sqlite
# PostgreSQL example: disable DASHBOARD_SQLITE_PATH and set your real URL below.
# DATABASE_URL=postgresql://user:password@localhost:5432/dashboard

# Used only by pnpm dashboard:setup. Existing users are never overwritten/promoted.
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_ADMIN_NAME=Administrator

# Email registration and password reset: use your authenticated SMTP service.
# Required in production. With all four credentials blank, local signup stays closed.
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS (usually 587); true = implicit TLS (usually 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A sender address authorized by your SMTP service, e.g. App <noreply@example.com>.
EMAIL_FROM=

# Enable ONE payment channel: none, stripe, or paypal. Restart after changing it.
# All payment keys are server-only. Configure only the selected channel.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# Register https://your-domain.example/api/payments/webhook with the selected provider.
# Stripe events: checkout.session.completed, checkout.session.async_payment_succeeded.
# PayPal events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED.
