# Copy this file to .env.local. Never commit .env.local.
BETTER_AUTH_URL=http://127.0.0.1:3001
# Generate a unique random secret with at least 32 characters. Empty is invalid.
BETTER_AUTH_SECRET=

# Choose ONE database. SQLite is local development only, never production.
DATABASE_URL=
DASHBOARD_SQLITE_PATH=.data/dashboard.sqlite
# PostgreSQL example: disable DASHBOARD_SQLITE_PATH and set your real URL below.
# DATABASE_URL=postgresql://user:password@localhost:5432/dashboard

# Used only by pnpm dashboard:setup. Existing users are never overwritten/promoted.
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_ADMIN_NAME=Administrator

# Optional Google login: leave BOTH blank to disable; partial configuration is invalid.
# Create a Web application OAuth client; keep its secret on the server.
# Register BETTER_AUTH_URL + /api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email registration and password reset: use your authenticated SMTP service.
# Required in production. With all four credentials blank, local email signup stays closed.
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS (usually 587); true = implicit TLS (usually 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A sender address authorized by your SMTP service, e.g. App <noreply@example.com>.
EMAIL_FROM=

# Enable ONE payment channel: none, stripe, paypal, or waffo. Restart after changing it.
# All payment keys are server-only. Configure only the selected channel.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# Register https://your-domain.example/api/payments/webhook with the selected provider.
# Stripe events: checkout.session.completed, checkout.session.async_payment_succeeded.
# PayPal events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED.
# Waffo: use an existing active one-time SaaS product; prod requires a published version.
# Catalog prices are pre-tax; Pancake calculates tax at checkout. BETTER_AUTH_URL must be HTTPS.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENVIRONMENT=test
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
# Waffo event: order.completed. Register the same webhook path in this store/environment.

# Optional confirmed signup/payment monitoring. Restart after configuration changes.
# Use an independent Collector site and server-only write credential per database.
APP_MONITOR_ENABLED=false
APP_MONITOR_SITE_ID=
APP_MONITOR_ENDPOINT=https://metrics.example.com/v1/server-events
APP_MONITOR_TOKEN=
APP_MONITOR_ENVIRONMENT=development
APP_MONITOR_ORIGINS_JSON=["http://127.0.0.1:3001"]
APP_MONITOR_ALLOWED_PATHS_JSON=[]
APP_MONITOR_RETRY_WINDOW_DAYS=7
# Must match the actual Collector retention; retry window must be strictly shorter.
APP_MONITOR_COLLECTOR_RETENTION_DAYS=30
