{
  "name": "@app/auth-sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-auth/better-auth.git"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" --workspace-concurrency=2 -r build",
    "build:sdk": "pnpm --filter @app/auth-sdk... --workspace-concurrency=2 -r build",
    "dev": "pnpm --filter @app/auth-sdk... --parallel -r dev",
    "typecheck": "tsc --build --force && tsc --project packages/app-sdk/tsconfig.test.json --noEmit && tsc --project packages/paypal/tsconfig.test.json --noEmit && tsc --project packages/subscription/tsconfig.test.json --noEmit",
    "test:sdk": "vitest run packages/app-sdk/test packages/paypal/test packages/subscription/test",
    "test:packaging": "node --test scripts/pack-sdk.test.mjs",
    "pack:sdk": "pnpm build:sdk && node scripts/pack-sdk.mjs",
    "lint": "biome check packages scripts --error-on-warnings",
    "format": "biome format packages scripts --write",
    "lint:packages": "pnpm --filter \"./packages/**\" -r lint:package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "publint": "^0.3.21",
    "typescript": "catalog:",
    "vitest": "catalog:vitest",
    "yaml": "^2.9.0"
  }
}
